# OpenAI (ör. scripts/seed_legal_data.py embedding + content engine)
# OPENAI_API_KEY=sk-...
# OPENAI_CONTENT_MODEL=gpt-4o-mini

# Gemini (opsiyonel — free tier sık 404/429; OpenAI/Groq öncelikli)
# GEMINI_API_KEY=...
# GEMINI_CONTENT_MODEL=gemini-flash-latest

# Canonical URL (SEO / OG / sitemap). Örn: https://tryclause.tech
NEXT_PUBLIC_SITE_URL=https://tryclause.tech

# Organization JSON-LD sameAs — virgülle ayrılmış tam profil URL’leri (LinkedIn, X, vb.)
# NEXT_PUBLIC_ORGANIZATION_SAME_AS=https://www.linkedin.com/company/...,https://twitter.com/...

# PostHog (istemci + iletişim formu sunucu capture)
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# İletişim lead: Live events → Contact_Form_Submitted | Sentry → 📩 YENİ İLETİŞİM TALEBİ
# Tam sözleşme metni (maskelenmiş, max ~8k) event’lere eklenir — KVKK için dikkatli kullanın
# NEXT_PUBLIC_POSTHOG_CAPTURE_INPUT=1

# İletişim formu: PostHog (Contact_Form_Submitted) + Sentry (📩 YENİ İLETİŞİM TALEBİ) yeterli
# İsteğe bağlı e-posta: RESEND_API_KEY=re_...  RESEND_FROM_EMAIL=Clause <...>

# Sentry — kaynak haritası yüklemek için SENTRY_AUTH_TOKEN, SENTRY_ORG, SENTRY_PROJECT
# NEXT_PUBLIC_SENTRY_DSN=https://...@....ingest.sentry.io/...

# Supabase — istemci (tarayıcı; RLS uygulanır). Gerçek değerleri yalnızca .env.local’de tutun.
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=sb_publishable_...
# Eski JWT anon anahtarı (ikisinden biri yeterli):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Supabase — yalnızca sunucu (asla NEXT_PUBLIC_ öneki kullanmayın; RLS bypass)
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Postgres şifresi (DB Settings). Migrasyon için: tercihen sunucu-only — tarayıcıya gitmez.
# SUPABASE_DB_PASSWORD=...

# Geçici / kolaylık (önerilmez): npm run db:migrate şifreyi buradan da okur; Next bundle’ına sızmaması için mümkünse yalnızca SUPABASE_DB_PASSWORD kullanın.
# NEXT_PUBLIC_SUPABASE_PASSWORD=...

# İsteğe bağlı: tam URI (varsa URL+şifre yerine bunu kullanır). Pooler IPv4 için:
# DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-....pooler.supabase.com:6543/postgres
# veya doğrudan:
# SUPABASE_DB_HOST=db.xxxx.supabase.co
# SUPABASE_DB_PORT=5432
